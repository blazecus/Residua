// rigidbody_integrate.comp
//
// Symplectic Euler integrator.
// Applies one impulse per unique colliding body (from ContactAggregate),
// plus Baumgarte positional correction from the overall body_l0 aggregate.
// One thread per rigid body.

#version 460
#extension GL_GOOGLE_include_directive : require
#include "physics_types.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint BODY_W = 4u;
layout(constant_id = 1) const uint BODY_H = 4u;

// ─── Bindings ─────────────────────────────────────────────────────────────────

layout(set = 0, binding = 0) readonly buffer RigidBodySrc {
    RigidBody bodies_src[];
};

layout(set = 0, binding = 1) writeonly buffer RigidBodyDst {
    RigidBody bodies_dst[];
};

layout(set = 0, binding = 2) readonly buffer PhysicsBuffer {
    PhysicsPixel physics[];
};

layout(set = 0, binding = 3) readonly buffer ActiveIndicesBuffer {
    uint active_indices[];
};

layout(set = 0, binding = 4) readonly buffer ContactAggBuffer {
    ContactAggregate contacts[];
};

// ─── Push constants ───────────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    uint  body_count;
    float dt;
    float restitution;
};

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    if (gl_GlobalInvocationID.x >= body_count) return;
    uint idx = active_indices[gl_GlobalInvocationID.x];

    RigidBody    body = bodies_src[idx];
    PhysicsPixel agg  = physics[idx];

    float mass = agg.total_mass;
    if (mass < 0.0001) return;

    float I      = max(agg.inertia_moment, 0.0001);
    float torque = agg.force_moment;

    // ── Symplectic Euler — gravity / torque ───────────────────────────────────
    vec2  new_velocity         = body.velocity         + (agg.total_force / mass) * dt;
    float new_angular_velocity = body.angular_velocity + (torque / I) * dt;

    vec2 baumgarte_correction = vec2(0.0);

    // ── One impulse per unique colliding body ─────────────────────────────────
    for (uint ci = 0u; ci < MAX_CONTACTS; ci++) {
        ContactAggregate ca = contacts[idx * MAX_CONTACTS + ci];
        if (ca.other_id == COLLISION_EMPTY) break;

        float wsum = ca.collision_count;
        if (wsum < 0.0001) continue;

        float nlen = length(ca.contact_normal);
        if (nlen < 0.001) continue;
        vec2 n = ca.contact_normal / nlen;

        // Remove gravity component that would push us into this surface
        float force_n = dot(agg.total_force / mass * dt, n);
        if (force_n < 0.0) new_velocity -= force_n * n;

        vec2  contact_pos = ca.contact_centroid / wsum;
        vec2  r           = contact_pos - body.position;
        float r_cross_n   = r.x * n.y - r.y * n.x;

        float raw_inv_m   = ca.contact_inv_mass / wsum;
        float other_inv_m = min(raw_inv_m, 1.0 / mass);
        float denom       = 1.0 / mass + other_inv_m + (r_cross_n * r_cross_n) / I;

        vec2  other_vel = (raw_inv_m > 0.0001) ? ca.contact_vel / wsum : vec2(0.0);
        vec2  v_contact = new_velocity + new_angular_velocity * vec2(-r.y, r.x) - other_vel;
        float v_n       = dot(v_contact, n);

        if (v_n < 0.0) {
            const float BOUNCE_THRESHOLD = 1.5;
            float e = abs(v_n) > BOUNCE_THRESHOLD ? restitution : 0.0;
            float J = -(1.0 + e) * v_n / denom;

            if (J > 0.0) {
                new_velocity         += (J / mass) * n;
                new_angular_velocity += (r_cross_n * J) / I;

                // Coulomb friction
                vec2  v_t     = v_contact - v_n * n;
                float v_t_len = length(v_t);
                if (v_t_len > 0.001) {
                    vec2  t         = v_t / v_t_len;
                    float r_cross_t = r.x * t.y - r.y * t.x;
                    float denom_t   = 1.0 / mass + (r_cross_t * r_cross_t) / I;
                    float J_t       = min(0.4 * J, v_t_len / denom_t);
                    new_velocity         -= (J_t / mass) * t;
                    new_angular_velocity -= (r_cross_t * J_t) / I;
                }
            }
        }

        // Ensure final velocity is not still moving into this surface
        float vn_com = dot(new_velocity, n);
        if (vn_com < 0.0) new_velocity -= vn_com * n;
    }

    // ── Baumgarte positional correction  ─────────
    if (agg.collision_count > 0.0001) {
        float nlen = length(agg.contact_normal);
        if (nlen > 0.001) {
            vec2  n          = agg.contact_normal / nlen;
            float pen_pixels = agg.collision_count / float(BODY_W);
            float pen_excess = max(pen_pixels - 0.5, 0.0);
            if (pen_excess > 0.001)
                baumgarte_correction = n * min(pen_excess * 0.15, 0.8);
        }
    }

    // TODO: better damping (needs dt independence)
    new_velocity *= 0.995;

    if (agg.collision_count > 0.0001) {
        if (length(new_velocity) < 0.1 && abs(new_angular_velocity) < 0.2) {
            new_velocity         = vec2(0.0);
            new_angular_velocity = 0.0;
        }
    }

    vec2  new_position = body.position + new_velocity         * dt + baumgarte_correction;
    float new_rotation = body.rotation + new_angular_velocity * dt;

    float I_com_new = max(agg.inertia_moment, 0.0001);

    RigidBody out_body;
    out_body.position         = new_position;
    out_body.rotation         = new_rotation;
    out_body.total_mass       = mass;
    out_body.velocity         = new_velocity;
    out_body.angular_velocity = new_angular_velocity;
    out_body.I_com            = I_com_new;
    out_body.pixel_index      = body.pixel_index;
    out_body._pad             = 0u;

    bodies_dst[idx] = out_body;
}
