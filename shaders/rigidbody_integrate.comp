// rigidbody_integrate.comp

#version 460
#extension GL_GOOGLE_include_directive : require
#include "physics_types.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint BODY_W = 4u;
layout(constant_id = 1) const uint BODY_H = 4u;

// ─── Bindings ─────────────────────────────────────────────────────────────────

layout(set = 0, binding = 0) readonly buffer RigidBodySrc {
    RigidBody bodies_src[];
};

layout(set = 0, binding = 1) writeonly buffer RigidBodyDst {
    RigidBody bodies_dst[];
};

layout(set = 0, binding = 2) readonly buffer PhysicsBuffer {
    PhysicsPixel physics[];
};

layout(set = 0, binding = 3) readonly buffer ActiveIndicesBuffer {
    uint active_indices[];
};

layout(set = 0, binding = 4) readonly buffer ContactManifoldBuffer {
    ContactPoint contact_manifold[];
};

// ─── Push constants ───────────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    uint  body_count;
    float dt;
    float restitution;
};

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    if (gl_GlobalInvocationID.x >= body_count) return;
    uint idx = active_indices[gl_GlobalInvocationID.x];

    RigidBody    body = bodies_src[idx];
    PhysicsPixel agg  = physics[idx];

    float mass = agg.total_mass;
    if (mass < 0.0001) return;

    float I      = max(agg.inertia_moment, 0.0001);
    float torque = agg.force_moment;

    vec2  new_velocity         = body.velocity + (agg.total_force / mass) * dt;
    float new_angular_velocity = body.angular_velocity + (torque / I) * dt;

    uint base_mp = idx * MAX_MANIFOLD_POINTS;
    ContactPoint contacts[MAX_MANIFOLD_POINTS];
    for (uint cp = 0u; cp < MAX_MANIFOLD_POINTS; cp++)
        contacts[cp] = contact_manifold[base_mp + cp];

    float K_n_arr  [MAX_MANIFOLD_POINTS];
    float K_t_arr  [MAX_MANIFOLD_POINTS];
    float target_arr[MAX_MANIFOLD_POINTS];  

    for (uint cp = 0u; cp < MAX_MANIFOLD_POINTS; cp++) {
        K_n_arr[cp]   = 0.0;
        K_t_arr[cp]   = 0.0;
        target_arr[cp] = 0.0;
        if (contacts[cp].other_id == COLLISION_EMPTY) continue;

        vec2  n = contacts[cp].normal;
        vec2  t = vec2(-n.y, n.x);
        vec2  r         = contacts[cp].position - body.position;
        float r_cross_n = r.x * n.y - r.y * n.x;
        float r_cross_t = r.x * t.y - r.y * t.x;

        float other_inv_m = contacts[cp].other_inv_m;  // no clamp: correct 2-body effective mass
        K_n_arr[cp] = 1.0 / mass + other_inv_m + (r_cross_n * r_cross_n) / I;
        K_t_arr[cp] = 1.0 / mass + other_inv_m + (r_cross_t * r_cross_t) / I;

        vec2  v_contact = new_velocity + new_angular_velocity * vec2(-r.y, r.x);
        float v_n_init  = dot(v_contact - contacts[cp].other_vel, n);

        float bias            = (0.2 / dt) * max(contacts[cp].depth - 1.0, 0.0);
        // Threshold ~10 px/s ≈ 6 frames of free-fall under gravity=100.
        float restitution_vel = (v_n_init < -10.0) ? -restitution * v_n_init : 0.0;
        target_arr[cp]        = max(bias, restitution_vel);
    }

    // ── Accumulated impulses (reset each frame — no warm-starting) ────────────
    float lambda_n[MAX_MANIFOLD_POINTS];
    float lambda_t[MAX_MANIFOLD_POINTS];
    for (uint cp = 0u; cp < MAX_MANIFOLD_POINTS; cp++) {
        lambda_n[cp] = 0.0;
        lambda_t[cp] = 0.0;
    }

    // ── Sequential impulse iterations ────────────────────────────────────────
    const int SI_ITERS = 8;
    for (int iter = 0; iter < SI_ITERS; iter++) {
        for (uint cp = 0u; cp < MAX_MANIFOLD_POINTS; cp++) {
            if (contacts[cp].other_id == COLLISION_EMPTY) continue;

            vec2  n = contacts[cp].normal;
            vec2  t = vec2(-n.y, n.x);
            vec2  r         = contacts[cp].position - body.position;
            float r_cross_n = r.x * n.y - r.y * n.x;
            float r_cross_t = r.x * t.y - r.y * t.x;

            float K_n = K_n_arr[cp];
            float K_t = K_t_arr[cp];

            vec2  v_contact = new_velocity + new_angular_velocity * vec2(-r.y, r.x);
            float v_n       = dot(v_contact - contacts[cp].other_vel, n);

            // Normal impulse — clamp accumulated so λ_n ≥ 0
            float delta_n  = (target_arr[cp] - v_n) / K_n;
            float old_n    = lambda_n[cp];
            lambda_n[cp]   = max(old_n + delta_n, 0.0);
            float actual_n = lambda_n[cp] - old_n;

            new_velocity         += (actual_n / mass) * n;
            new_angular_velocity += r_cross_n * actual_n / I;

            // Friction impulse — Coulomb cone: |λ_t| ≤ μ·λ_n
            v_contact = new_velocity + new_angular_velocity * vec2(-r.y, r.x);
            float v_t      = dot(v_contact - contacts[cp].other_vel, t);
            float delta_t  = -v_t / K_t;
            float old_t    = lambda_t[cp];
            float friction_limit = 0.3 * lambda_n[cp];
            lambda_t[cp]   = clamp(old_t + delta_t, -friction_limit, friction_limit);
            float actual_t = lambda_t[cp] - old_t;

            new_velocity         += (actual_t / mass) * t;
            new_angular_velocity += r_cross_t * actual_t / I;
        }
    }

    // ── Damping ───────────────────────────────────────────────────────────────
    // TODO: make dt-independent
    new_velocity *= 0.995;

    // ── Sleep condition ───────────────────────────────────────────────────────
    if (agg.collision_count > 0.0001) {
        if (length(new_velocity) < 0.1 && abs(new_angular_velocity) < 0.2) {
            new_velocity         = vec2(0.0);
            new_angular_velocity = 0.0;
        }
    }

    vec2  new_position = body.position + new_velocity         * dt;
    float new_rotation = body.rotation + new_angular_velocity * dt;

    RigidBody out_body;
    out_body.position         = new_position;
    out_body.rotation         = new_rotation;
    out_body.total_mass       = mass;
    out_body.velocity         = new_velocity;
    out_body.angular_velocity = new_angular_velocity;
    out_body.I_com            = max(agg.inertia_moment, 0.0001);
    out_body.pixel_index      = body.pixel_index;
    out_body._pad             = 0u;

    bodies_dst[idx] = out_body;
}
