// rigidbody_integrate.comp
//
// Symplectic Euler integrator with impulse-based collision response.
// One thread per rigid body.

#version 460
#extension GL_GOOGLE_include_directive : require
#include "physics_types.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint BODY_W = 4u;
layout(constant_id = 1) const uint BODY_H = 4u;

// ─── Bindings ─────────────────────────────────────────────────────────────────

layout(set = 0, binding = 0) readonly buffer RigidBodySrc {
    RigidBody bodies_src[];
};

layout(set = 0, binding = 1) writeonly buffer RigidBodyDst {
    RigidBody bodies_dst[];
};

layout(set = 0, binding = 2) readonly buffer PhysicsBuffer {
    PhysicsPixel physics[];
};

layout(set = 0, binding = 3) readonly buffer ActiveIndicesBuffer {
    uint active_indices[];
};

// ─── Push constants ───────────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    uint  body_count;
    float dt;
    float restitution;   
};

const float SEPARATION_SPEED = 8.0;

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    if (gl_GlobalInvocationID.x >= body_count) return;
    uint idx = active_indices[gl_GlobalInvocationID.x];

    RigidBody    body = bodies_src[idx];
    PhysicsPixel agg  = physics[idx];

    float mass = agg.total_mass;
    if (mass < 0.0001) return; // degenerate body

    // I_origin = Σ(m_i × |pos_i_world|²), I_com = I_origin - M × |CoM|²
    float I = max(agg.inertia_moment - mass * dot(body.position, body.position), 0.0001);

    float torque = agg.force_moment
                 - (body.position.x * agg.total_force.y
                 -  body.position.y * agg.total_force.x);

    // ── Symplectic Euler ──────────────────────────────────────────────────────
    // TODO: better integration method if necessary
    vec2  new_velocity         = body.velocity         + (agg.total_force / mass) * dt;
    float new_angular_velocity = body.angular_velocity + (torque / I) * dt;

    vec2  baumgarte_correction = vec2(0.0);

    if (agg.collision_count > 0.0001) {
        float nlen = length(agg.contact_normal);
        if (nlen > 0.001) {
            vec2 n = agg.contact_normal / nlen;

            vec2 contact_pos = agg.contact_centroid / agg.collision_count;
            vec2 r           = contact_pos - body.position;

            vec2 v_contact = new_velocity + new_angular_velocity * vec2(-r.y, r.x);
            float v_n      = dot(v_contact, n);

            float penetration = clamp(agg.collision_count / mass, 0.0, 1.0);

            float v_target = penetration * SEPARATION_SPEED;

            if (v_n < v_target) {
                float r_cross_n = r.x * n.y - r.y * n.x;
                float denom     = 1.0 / mass + (r_cross_n * r_cross_n) / I;

                const float VELOCITY_THRESHOLD = 2.0;
                float e = abs(v_n) > VELOCITY_THRESHOLD ? restitution : 0.0;

                float J = -(1.0 + e) * v_n / denom;
                J += v_target / denom;

                new_velocity         += (J / mass) * n;
                new_angular_velocity += (r_cross_n * J) / I;
            }

            const float BAUMGARTE = 0.3;
            baumgarte_correction = n * penetration * BAUMGARTE;
        }
    }

    vec2  new_position = body.position + new_velocity         * dt + baumgarte_correction;
    float new_rotation = body.rotation + new_angular_velocity * dt;

    float I_com_new = max(agg.inertia_moment - mass * dot(new_position, new_position), 0.0001);

    RigidBody out_body;
    out_body.position         = new_position;
    out_body.rotation         = new_rotation;
    out_body.total_mass       = mass;
    out_body.velocity         = new_velocity;
    out_body.angular_velocity = new_angular_velocity;
    out_body.I_com            = I_com_new;
    out_body.pixel_index      = body.pixel_index;
    out_body._pad             = 0u;

    bodies_dst[idx] = out_body;
}
