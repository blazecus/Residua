// gap_fill.comp
//
// Fills holes left by the forward-mapped rigid body draw pass.
// For each empty pixel (alpha == 0) with at least 2 colored neighbors,
// writes the averaged color to output_image and propagates collision data
// from the most common neighboring body into collision_pixels.

#version 460
#extension GL_GOOGLE_include_directive : require
#include "physics_types.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ─── Bindings ─────────────────────────────────────────────────────────────────

layout(rgba16f, set = 0, binding = 0) uniform image2D output_image;

layout(set = 0, binding = 1) buffer CollisionBuffer {
    CollisionPixel collision_pixels[];
};

// ─── Push constants ───────────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
};

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(width) || coord.y >= int(height)) return;

    if (imageLoad(output_image, coord).a > 0.0) return; // already filled

    vec4  color_sum  = vec4(0.0);
    float color_count = 0.0;

    uint  fill_body_id   = COLLISION_EMPTY;
    float fill_vel_x     = 0.0;
    float fill_vel_y     = 0.0;

    ivec2 cardinals[] = {ivec2(-1,0), ivec2(1,0), ivec2(0, -1), ivec2(0,1)};

    CollisionPixel first_type;
    CollisionPixel second_type;

    uint first_count = 0;
    uint second_count = 0;
    for(uint i = 0; i < 4; i++){
        ivec2 card = cardinals[i];
        ivec2 nc = coord + card;
        if (nc.x < 0 || nc.y < 0 ||
            nc.x >= int(width) || nc.y >= int(height)) continue;

        vec4 nb = imageLoad(output_image, nc);
        if (nb.a > 0.0) {
            color_sum   += nb;
            color_count += 1.0;

            uint nb_idx = uint(nc.y) * width + uint(nc.x);
            CollisionPixel collision = collision_pixels[nb_idx];

            if(first_count == 0){
                first_type = collision;
            }
            else if(second_count == 0){
                second_type = collision;
            }

            if(collision.body_id == first_type.body_id){
                first_count++;
            }
            else if(collision.body_id == second_type.body_id){
                second_count++;
            }
            else{
                return;
            }
        }
    }

    CollisionPixel result;
    if(first_count >= 3 && first_type.body_id != COLLISION_EMPTY && first_type.body_id != COLLISION_STATIC){
        result = first_type;
    }
    else if(second_count >= 3 && second_type.body_id != COLLISION_EMPTY && second_type.body_id != COLLISION_STATIC){
        result = second_type;
    }
    else{
        return;
    }
    imageStore(output_image, coord, color_sum / color_count);

    if (fill_body_id != COLLISION_EMPTY) {
        uint dst_idx = uint(coord.y) * width + uint(coord.x);
        collision_pixels[dst_idx].body_id = fill_body_id;
        collision_pixels[dst_idx].vel_x   = fill_vel_x;
        collision_pixels[dst_idx].vel_y   = fill_vel_y;
    }
}
