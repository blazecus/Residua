// gap_fill.comp
//
// Fills single-pixel gaps between body sprites by averaging neighboring pixel colors.
// A pixel is filled if it is empty (alpha == 0) and has more than 2 filled cardinal neighbors.

#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform image2D output_image;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
};

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(width) || coord.y >= int(height)) return;
    if (imageLoad(output_image, coord).a > 0.0) return;

    vec4  color_sum   = vec4(0.0);
    float color_count = 0.0;

    const ivec2 cardinals[4] = {ivec2(-1,0), ivec2(1,0), ivec2(0,-1), ivec2(0,1)};
    for (uint i = 0; i < 4; i++) {
        ivec2 nc = coord + cardinals[i];
        if (nc.x < 0 || nc.y < 0 || nc.x >= int(width) || nc.y >= int(height)) continue;
        vec4 nb = imageLoad(output_image, nc);
        if (nb.a <= 0.0) continue;
        color_sum   += nb;
        color_count += 1.0;
    }

    if (color_count <= 2.0) return;
    imageStore(output_image, coord, color_sum / color_count);
}
