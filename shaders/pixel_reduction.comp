// PIXEL REDUCTION
// takes input physics buffer and maps it to a physics buffer 4x smaller in each dimension
// used to aggregate physics per pixel

#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "physics_types.glsl"

layout(constant_id = 0) const uint BODY_W = 4u;
layout(constant_id = 1) const uint BODY_H = 4u;

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;

// ─── Bindings ─────────────────────────────────────────────────────────────────

layout(set = 0, binding = 0) readonly  buffer SrcBuffer { PhysicsPixel src[]; };
layout(set = 0, binding = 1) writeonly buffer DstBuffer { PhysicsPixel dst[]; };
layout(set = 0, binding = 2) readonly  buffer ActiveIndicesBuffer { uint active_indices[]; };

// ─── Push constants ───────────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    uint body_count; // active body count
};

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    if (gl_WorkGroupID.x >= body_count) return;
    uint body_idx = active_indices[gl_WorkGroupID.x];

    uint src_idx = body_idx * (BODY_W * BODY_H)
                 + gl_LocalInvocationID.y * BODY_W
                 + gl_LocalInvocationID.x;

    PhysicsPixel s = src[src_idx];

    float fx        = subgroupAdd(s.total_force.x);
    float fy        = subgroupAdd(s.total_force.y);
    float fm        = subgroupAdd(s.force_moment);
    float mass      = subgroupAdd(s.total_mass);
    float inertia   = subgroupAdd(s.inertia_moment);
    float collision = subgroupAdd(s.collision_count);
    float cnx       = subgroupAdd(s.contact_normal.x);
    float cny       = subgroupAdd(s.contact_normal.y);
    float ccx       = subgroupAdd(s.contact_centroid.x);
    float ccy       = subgroupAdd(s.contact_centroid.y);

    if (gl_SubgroupInvocationID == 0u) {
        PhysicsPixel d;
        d.total_force      = vec2(fx, fy);
        d.force_moment     = fm;
        d.total_mass       = mass;
        d.inertia_moment   = inertia;
        d.collision_count  = collision;
        d.contact_normal   = vec2(cnx, cny);
        d.contact_centroid = vec2(ccx, ccy);

        dst[body_idx] = d; // sparse write into stable slot
    }
}
