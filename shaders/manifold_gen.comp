#version 460

struct BodyInfo {
    vec2  pos;
    float angle;
    uint  edge_offset;
    uint  edge_count;
    uint  sdf_offset;
    uint  sdf_w;
    uint  sdf_h;
    vec2  com_local;
};

struct Contact {
    vec2  world_pt;
    vec2  normal;
    float depth;
    uint  body_a;
    uint  body_b;
    uint  _pad;
};

struct Pair {
    uint body_a;
    uint body_b;
};

layout(std430, set = 0, binding = 0) readonly  buffer BodyBuffer    { BodyInfo bodies[];      };
layout(std430, set = 0, binding = 1) readonly  buffer SDFBuffer     { float    sdf_data[];    };
layout(std430, set = 0, binding = 2) readonly  buffer VertBuffer    { vec2     verts[];       };
layout(std430, set = 0, binding = 3) readonly  buffer PairBuffer    { Pair     pairs[];       };
layout(std430, set = 0, binding = 4)           buffer ContactBuffer { Contact  contacts[];    };
layout(std430, set = 0, binding = 5)           buffer CounterBuffer { uint     contact_count; };

layout(push_constant) uniform PC {
    uint  pair_count;
    uint  max_contacts;
    float sdf_scale;
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

float sample_sdf_pix(uint offset, uint w, uint h, int x, int y) {
    if (x >= 0 && y >= 0 && x < int(w) && y < int(h))
        return sdf_data[offset + uint(y) * w + uint(x)];
    float dx = x < 0 ? float(-x) : (x >= int(w) ? float(x - int(w) + 1) : 0.0);
    float dy = y < 0 ? float(-y) : (y >= int(h) ? float(y - int(h) + 1) : 0.0);
    return dx + dy;
}

float sample_sdf(uint offset, uint w, uint h, vec2 p) {
    int x0 = int(floor(p.x)), y0 = int(floor(p.y));
    int x1 = x0 + 1, y1 = y0 + 1;
    float fx = p.x - float(x0), fy = p.y - float(y0);
    return sample_sdf_pix(offset, w, h, x0, y0) * (1.0-fx)*(1.0-fy)
         + sample_sdf_pix(offset, w, h, x1, y0) * fx*(1.0-fy)
         + sample_sdf_pix(offset, w, h, x0, y1) * (1.0-fx)*fy
         + sample_sdf_pix(offset, w, h, x1, y1) * fx*fy;
}

vec2 world_to_img(vec2 wp, BodyInfo ref) {
    float c = cos(-ref.angle), s = sin(-ref.angle);
    vec2  d = wp - ref.pos;
    vec2  local = vec2(c*d.x - s*d.y, s*d.x + c*d.y);
    return local * sdf_scale + ref.com_local * sdf_scale + vec2(float(ref.sdf_w)*0.5, float(ref.sdf_h)*0.5);
}

vec2 rotate2D(vec2 v, float angle) {
    float c = cos(angle), s = sin(angle);
    return vec2(c*v.x - s*v.y, s*v.x + c*v.y);
}

#define MAX_CANDS 4

// For each vertex of query that lies inside ref (SDF < 0), emit a contact.
// Normal convention: points from body_a toward body_b.
//   normal_sign = +1: ref=A, query=B → n = -outward_B  (points A→B)
//   normal_sign = -1: ref=B, query=A → n = +outward_A  (points A→B)
void test_edges_vs_sdf(BodyInfo ref, BodyInfo query, uint body_a, uint body_b, float normal_sign) {
    uint n = query.edge_count;
    if (n < 3u || ref.sdf_w == 0u) return;

    // Compute signed area to determine winding order.
    // Positive = CCW in standard y-up math (CW on screen, like static rects).
    // Negative = CW in standard y-up math (CCW on screen, like marching-squares shapes).
    // Outward normal formula: winding * (ey, -ex) handles both conventions.
    float signed_area = 0.0;
    for (uint vi = 0u; vi < n; vi++) {
        vec2 a = verts[query.edge_offset + vi];
        vec2 b = verts[query.edge_offset + (vi + 1u) % n];
        signed_area += a.x * b.y - b.x * a.y;
    }
    float winding = signed_area > 0.0 ? 1.0 : -1.0;

    vec2  cand_pt   [MAX_CANDS];
    vec2  cand_norm [MAX_CANDS];
    float cand_depth[MAX_CANDS];
    int   n_cands      = 0;
    float min_cand_d   = 1e30;
    int   min_cand_idx = 0;

    for (uint vi = 0u; vi < n; vi++) {
        vec2 v_local = verts[query.edge_offset + vi];
        vec2 v_world = query.pos + rotate2D(v_local, query.angle);

        // Depth from ref SDF (image pixels, negative = inside)
        vec2  r_img = world_to_img(v_world, ref);
        float d_r   = sample_sdf(ref.sdf_offset, ref.sdf_w, ref.sdf_h, r_img);
        if (d_r >= 0.0) continue;

        float depth = -d_r / sdf_scale;  // positive penetration in world units

        // Adjacent vertices for edge normal computation.
        vec2 v_prev = verts[query.edge_offset + (vi + n - 1u) % n];
        vec2 v_next = verts[query.edge_offset + (vi + 1u)     % n];

        // Outward edge normals: winding * (ey, -ex) gives correct direction
        // for both CW-on-screen (winding=+1) and CCW-on-screen (winding=-1) polygons.
        vec2 e_prev = v_local - v_prev;
        vec2 e_next = v_next  - v_local;
        float lp = length(e_prev), ln = length(e_next);
        vec2 n_prev = lp > 1e-6 ? winding * vec2(e_prev.y, -e_prev.x) / lp : vec2(0.0);
        vec2 n_next = ln > 1e-6 ? winding * vec2(e_next.y, -e_next.x) / ln : vec2(0.0);

        vec2  n_sum = n_prev + n_next;
        float nl    = length(n_sum);
        if (nl < 1e-6) continue;
        vec2 n_local = n_sum / nl;

        // World-space contact normal (points from body_a toward body_b)
        vec2 contact_n = -rotate2D(n_local, query.angle) * normal_sign;

        if (n_cands < MAX_CANDS) {
            cand_pt   [n_cands] = v_world;
            cand_norm [n_cands] = contact_n;
            cand_depth[n_cands] = depth;
            if (depth < min_cand_d) { min_cand_d = depth; min_cand_idx = n_cands; }
            n_cands++;
        } else if (depth > min_cand_d) {
            cand_pt   [min_cand_idx] = v_world;
            cand_norm [min_cand_idx] = contact_n;
            cand_depth[min_cand_idx] = depth;
            min_cand_d = cand_depth[0]; min_cand_idx = 0;
            for (int i = 1; i < MAX_CANDS; i++) {
                if (cand_depth[i] < min_cand_d) {
                    min_cand_d   = cand_depth[i];
                    min_cand_idx = i;
                }
            }
        }
    }

    for (int i = 0; i < n_cands; i++) {
        uint idx = atomicAdd(contact_count, 1u);
        if (idx < max_contacts) {
            contacts[idx].world_pt = cand_pt[i];
            contacts[idx].normal   = cand_norm[i];
            contacts[idx].depth    = cand_depth[i];
            contacts[idx].body_a   = body_a;
            contacts[idx].body_b   = body_b;
            contacts[idx]._pad     = 0u;
        }
    }
}

void main() {
    uint pid = gl_GlobalInvocationID.x;
    if (pid >= pair_count) return;

    uint idxA = pairs[pid].body_a;
    uint idxB = pairs[pid].body_b;

    BodyInfo a = bodies[idxA];
    BodyInfo b = bodies[idxB];

    // Pass 1: B vertices vs A SDF → n = -outward_B → points A→B
    if (a.sdf_w > 0u && b.edge_count > 0u)
        test_edges_vs_sdf(a, b, idxA, idxB, +1.0);

    // Pass 2: A vertices vs B SDF → n = +outward_A → points A→B
    if (b.sdf_w > 0u && a.edge_count > 0u)
        test_edges_vs_sdf(b, a, idxA, idxB, -1.0);
}
