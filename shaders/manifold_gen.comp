#version 460

struct BodyInfo {
    vec2  pos;
    float angle;
    uint  edge_offset;
    uint  edge_count;
    uint  sdf_offset;
    uint  sdf_w;
    uint  sdf_h;
    vec2  com_local;
};

struct Contact {
    vec2  world_pt;
    vec2  normal;
    float depth;
    uint  body_a;
    uint  body_b;
    uint  _pad;
};

struct Pair {
    uint body_a;
    uint body_b;
};

layout(std430, set = 0, binding = 0) readonly  buffer BodyBuffer    { BodyInfo bodies[];      };
layout(std430, set = 0, binding = 1) readonly  buffer SDFBuffer     { float    sdf_data[];    };
layout(std430, set = 0, binding = 2) readonly  buffer VertBuffer    { vec2     verts[];       };
layout(std430, set = 0, binding = 3) readonly  buffer PairBuffer    { Pair     pairs[];       };
layout(std430, set = 0, binding = 4)           buffer ContactBuffer { Contact  contacts[];    };
layout(std430, set = 0, binding = 5)           buffer CounterBuffer { uint     contact_count; };

layout(push_constant) uniform PC {
    uint  pair_count;
    uint  max_contacts;
    float sdf_scale;
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

float sample_sdf_pix(uint offset, uint w, uint h, int x, int y) {
    if (x >= 0 && y >= 0 && x < int(w) && y < int(h))
        return sdf_data[offset + uint(y) * w + uint(x)];
    float dx = x < 0 ? float(-x) : (x >= int(w) ? float(x - int(w) + 1) : 0.0);
    float dy = y < 0 ? float(-y) : (y >= int(h) ? float(y - int(h) + 1) : 0.0);
    return dx + dy;
}

float sample_sdf(uint offset, uint w, uint h, vec2 p) {
    int x0 = int(floor(p.x)), y0 = int(floor(p.y));
    int x1 = x0 + 1, y1 = y0 + 1;
    float fx = p.x - float(x0), fy = p.y - float(y0);
    return sample_sdf_pix(offset, w, h, x0, y0) * (1.0-fx)*(1.0-fy)
         + sample_sdf_pix(offset, w, h, x1, y0) * fx*(1.0-fy)
         + sample_sdf_pix(offset, w, h, x0, y1) * (1.0-fx)*fy
         + sample_sdf_pix(offset, w, h, x1, y1) * fx*fy;
}

vec2 sdf_gradient(uint offset, uint w, uint h, vec2 p) {
    float dx = sample_sdf(offset, w, h, p + vec2(1,0)) - sample_sdf(offset, w, h, p - vec2(1,0));
    float dy = sample_sdf(offset, w, h, p + vec2(0,1)) - sample_sdf(offset, w, h, p - vec2(0,1));
    return vec2(dx, dy) * 0.5;
}

vec2 world_to_img(vec2 wp, BodyInfo ref) {
    float c = cos(-ref.angle), s = sin(-ref.angle);
    vec2  d = wp - ref.pos;
    vec2  local = vec2(c*d.x - s*d.y, s*d.x + c*d.y);
    return local * sdf_scale + ref.com_local * sdf_scale + vec2(float(ref.sdf_w)*0.5, float(ref.sdf_h)*0.5);
}

vec2 img_to_world(vec2 ip, BodyInfo ref) {
    vec2  local = (ip - ref.com_local * sdf_scale - vec2(float(ref.sdf_w)*0.5, float(ref.sdf_h)*0.5)) / sdf_scale;
    float c = cos(ref.angle), s = sin(ref.angle);
    return ref.pos + vec2(c*local.x - s*local.y, s*local.x + c*local.y);
}

vec2 rotate2D(vec2 v, float angle) {
    float c = cos(angle), s = sin(angle);
    return vec2(c*v.x - s*v.y, s*v.x + c*v.y);
}

vec2 robust_gradient(BodyInfo ref, vec2 contact_img, vec2 outside_img) {
    vec2  grad = sdf_gradient(ref.sdf_offset, ref.sdf_w, ref.sdf_h, contact_img);
    float len  = length(grad);
    if (len < 1e-3) {
        vec2  toward = outside_img - contact_img;
        float td     = length(toward);
        if (td > 1e-6) {
            vec2 dir = toward / td;
            for (float step = 1.0; step <= 8.0; step += 1.0) {
                vec2  g  = sdf_gradient(ref.sdf_offset, ref.sdf_w, ref.sdf_h,
                                        contact_img + dir * step);
                float gl = length(g);
                if (gl > len) { grad = g; len = gl; }
                if (len > 1e-3) break;
            }
        }
    }
    if (len < 1e-6) {
        // Final fallback: direction toward query body center.
        grad = outside_img - contact_img;
    }
    return grad;
}

void emit_contact(BodyInfo ref, uint body_a, uint body_b,
                  vec2 contact_img, float depth_world,
                  vec2 outside_img, float normal_sign)
{
    vec2 grad    = robust_gradient(ref, contact_img, outside_img);
    float len    = length(grad);
    if (len < 1e-6) return;

    vec2 n_local = grad / len;
    if (dot(n_local, outside_img - contact_img) < 0.0)
        n_local = -n_local;

    float c = cos(ref.angle), s = sin(ref.angle);
    vec2  n = vec2(c*n_local.x - s*n_local.y, s*n_local.x + c*n_local.y) * normal_sign;

    uint idx = atomicAdd(contact_count, 1u);
    if (idx < max_contacts) {
        contacts[idx].world_pt = img_to_world(contact_img, ref);
        contacts[idx].normal   = n;
        contacts[idx].depth    = depth_world;
        contacts[idx].body_a   = body_a;
        contacts[idx].body_b   = body_b;
        contacts[idx]._pad     = 0u;
    }
}

#define MAX_CANDS 4

void test_verts_vs_sdf(BodyInfo ref, BodyInfo query,
                       uint body_a, uint body_b, float normal_sign)
{
    uint n = query.edge_count;
    if (n == 0u || ref.sdf_w == 0u) return;

    vec2 outside_img = world_to_img(query.pos, ref);

    vec2  cand_img  [MAX_CANDS];
    float cand_depth[MAX_CANDS];
    int   n_cands = 0, min_idx = 0;
    float min_d   = 1e30;

    for (uint vi = 0u; vi < n; vi++) {
        vec2 v_world = query.pos + rotate2D(verts[query.edge_offset + vi], query.angle);
        vec2 r_img   = world_to_img(v_world, ref);
        float d_r    = sample_sdf(ref.sdf_offset, ref.sdf_w, ref.sdf_h, r_img);
        if (d_r >= 0.0) continue;

        float depth = -d_r / sdf_scale;  // world units, positive

        if (n_cands < MAX_CANDS) {
            cand_img  [n_cands] = r_img;
            cand_depth[n_cands] = depth;
            if (depth < min_d) { min_d = depth; min_idx = n_cands; }
            n_cands++;
        } else if (depth > min_d) {
            cand_img  [min_idx] = r_img;
            cand_depth[min_idx] = depth;
            min_d = cand_depth[0]; min_idx = 0;
            for (int i = 1; i < MAX_CANDS; i++)
                if (cand_depth[i] < min_d) { min_d = cand_depth[i]; min_idx = i; }
        }
    }

    for (int i = 0; i < n_cands; i++)
        emit_contact(ref, body_a, body_b,
                     cand_img[i], cand_depth[i], outside_img, normal_sign);
}

void main() {
    uint pid = gl_GlobalInvocationID.x;
    if (pid >= pair_count) return;

    uint idxA = pairs[pid].body_a;
    uint idxB = pairs[pid].body_b;

    BodyInfo a = bodies[idxA];
    BodyInfo b = bodies[idxB];

    // Pass 1: B vertices vs A SDF → normal points A→B
    if (a.sdf_w > 0u && b.edge_count > 0u)
        test_verts_vs_sdf(a, b, idxA, idxB, +1.0);

    // Pass 2: A vertices vs B SDF → normal points A→B
    if (b.sdf_w > 0u && a.edge_count > 0u)
        test_verts_vs_sdf(b, a, idxA, idxB, -1.0);
}
