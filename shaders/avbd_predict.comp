// avbd_predict.comp  —  Algorithm 1, lines 3-4
//
// Per dynamic body:
//   save x^t  → prev_pos / prev_rot
//   y = x + dt*v + dt²*a_ext   (inertia target, line 3)
//   x ← y                       (initial guess,  line 4)

#version 460
#extension GL_GOOGLE_include_directive : require
#include "lbvh_types.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    float dt;
    float grav_x;
    float grav_y;
    uint  body_count;
};

layout(set = 0, binding = 0) buffer BodyBuf    { RigidBody    bodies[]; };
layout(set = 0, binding = 1) buffer InertiaBuf { InertiaTarget inertia[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= body_count) return;
    if (bodies[i].inv_mass == 0.0) return;   // static body

    // Save x^t for velocity update at end of step
    bodies[i].prev_pos = bodies[i].position;
    bodies[i].prev_rot = bodies[i].rotation;

    // Inertia target y = x + dt*v + dt²*a_ext
    vec2 a_ext = vec2(grav_x, grav_y);
    inertia[i].pos = bodies[i].position
                   + dt * bodies[i].velocity
                   + dt * dt * a_ext;
    inertia[i].rot = bodies[i].rotation + dt * bodies[i].ang_vel;

    // Initial guess x = y
    bodies[i].position = inertia[i].pos;
    bodies[i].rotation = inertia[i].rot;
}
