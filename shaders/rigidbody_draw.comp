// rigidbody_draw.comp
//
// Draws rigid bodies into the output image.
// might want to consider the benefits of using a workgroup per body instead of traversing the entire image and retrieving body index from pixel index 

#version 460
#include "physics_types.glsl"

layout(constant_id = 0) const uint BODY_W = 4u;
layout(constant_id = 1) const uint BODY_H = 4u;

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;

// ─── Bindings ─────────────────────────────────────────────────────────────────

layout(set = 0, binding = 0) readonly buffer RigidBodyBuffer {
    RigidBody bodies[];
};

layout(set = 0, binding = 1) readonly buffer PixelColorBuffer {
    vec4 pixel_colors[];
};

layout(rgba16f, set = 0, binding = 2) uniform image2D output_image;

// ─── Push constants ───────────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    uint body_count;
};

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    uint body_idx = gl_WorkGroupID.x;
    if (body_idx >= body_count) return;

    RigidBody body = bodies[body_idx];

    vec2 local_pos = vec2(gl_LocalInvocationID.xy) - vec2(BODY_W, BODY_H) * 0.5 + 0.5;

    float c = cos(body.rotation);
    float s = sin(body.rotation);
    vec2 world_pos = body.position + vec2(
        c * local_pos.x - s * local_pos.y,
        s * local_pos.x + c * local_pos.y
    );

    ivec2 out_coord = ivec2(floor(world_pos));
    ivec2 image_size = imageSize(output_image);
    if (out_coord.x < 0 || out_coord.y < 0 ||
        out_coord.x >= image_size.x || out_coord.y >= image_size.y) return;

    uint local_idx = gl_LocalInvocationID.y * BODY_W + gl_LocalInvocationID.x;
    vec4 color = pixel_colors[body.pixel_index + local_idx];

    imageStore(output_image, out_coord, color);
}
