// rigidbody_draw_cpu.comp
//
// CPU-physics draw pass: writes rigid body pixel colors into the output image
// and records collision occupancy for gap_fill.
// One workgroup per active body; 256 threads loop over all body pixels.
// Body dimensions are read from the buffer (no specialization constants).

#version 460
#extension GL_GOOGLE_include_directive : require
#include "physics_types.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ─── GPU body struct (matches RigidBodyDrawGPU on the CPU side) ───────────────

struct RigidBodyDraw {
    vec2  position;          // world-space center (pixels)
    float rotation;          // radians
    float total_mass;
    vec2  velocity;          // pixels/s
    float angular_velocity;  // radians/s
    float I_com;
    uint  pixel_index;       // base offset into pixel_colors[]
    uint  body_w;
    uint  body_h;
    uint  _pad;
};

// ─── Bindings ─────────────────────────────────────────────────────────────────

layout(set = 0, binding = 0) readonly buffer RigidBodyDrawBuffer {
    RigidBodyDraw bodies[];
};

layout(set = 0, binding = 1) readonly buffer PixelColorBuffer {
    vec4 pixel_colors[];
};

layout(rgba16f, set = 0, binding = 2) uniform image2D output_image;

layout(set = 0, binding = 3) buffer CollisionBuffer {
    CollisionPixel collision_pixels[];
};

layout(set = 0, binding = 4) readonly buffer ActiveIndicesBuffer {
    uint active_indices[];
};

// ─── Push constants ───────────────────────────────────────────────────────────

layout(push_constant) uniform PushConstants {
    uint body_count;
    uint physics_width;
};

// ─── Main ─────────────────────────────────────────────────────────────────────

void main() {
    if (gl_WorkGroupID.x >= body_count) return;
    uint body_idx = active_indices[gl_WorkGroupID.x];

    RigidBodyDraw body = bodies[body_idx];
    uint self_id = body_idx + 1u;  // 0 = COLLISION_EMPTY, so ids start at 1

    float c = cos(body.rotation);
    float s = sin(body.rotation);

    uint BODY_PIXELS = body.body_w * body.body_h;

    for (uint i = gl_LocalInvocationID.x; i < BODY_PIXELS; i += 256u) {
        uint lx = i % body.body_w;
        uint ly = i / body.body_w;

        // Center the sprite on body.position
        vec2 local_pos = vec2(float(lx), float(ly))
                       - vec2(float(body.body_w), float(body.body_h)) * 0.5 + 0.5;
        vec2 world_pos = body.position + vec2(
            c * local_pos.x - s * local_pos.y,
            s * local_pos.x + c * local_pos.y
        );

        ivec2 out_coord  = ivec2(floor(world_pos));
        ivec2 image_size = imageSize(output_image);
        if (out_coord.x < 0 || out_coord.y < 0 ||
            out_coord.x >= image_size.x || out_coord.y >= image_size.y) continue;

        vec4 color = pixel_colors[body.pixel_index + i];
        if (color.a <= 0.0) continue;

        imageStore(output_image, out_coord, color);

        uint flat_idx = uint(out_coord.y) * physics_width + uint(out_coord.x);
        if (collision_pixels[flat_idx].body_id != COLLISION_STATIC) {
            vec2 r            = world_pos - body.position;
            vec2 vel_at_pixel = body.velocity + body.angular_velocity * vec2(-r.y, r.x);

            uint prev = atomicCompSwap(collision_pixels[flat_idx].body_id,
                                       COLLISION_EMPTY, self_id);
            if (prev == COLLISION_EMPTY) {
                collision_pixels[flat_idx].vel_x = vel_at_pixel.x;
                collision_pixels[flat_idx].vel_y = vel_at_pixel.y;
                collision_pixels[flat_idx].mass  = body.total_mass;
            } else if (prev != self_id) {
                uint prev2 = atomicCompSwap(collision_pixels[flat_idx].body_id2,
                                            COLLISION_EMPTY, self_id);
                if (prev2 == COLLISION_EMPTY) {
                    collision_pixels[flat_idx].vel_x2 = vel_at_pixel.x;
                    collision_pixels[flat_idx].vel_y2 = vel_at_pixel.y;
                    collision_pixels[flat_idx].mass2  = body.total_mass;
                }
            }
        }
    }
}
