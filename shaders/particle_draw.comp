#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uvec2 grid_size;       // particle grid dims (physics_size / cell_size)
    uint  particle_count;
    uint  cell_size;
} pc;

struct Particle {
    vec2  position;
    vec2  displacement;
    mat2  deformation_gradient;
    mat2  deformation_displacement;
    float liquid_density;
    float mass;
    float material;
    float volume;
    float log_jp;
    float enabled;
    vec2  _pad;
    vec4  color;
};

layout(std430, set=0, binding=0) readonly buffer ParticleBuffer {
    Particle particles[];
};

layout(rgba16f, set=0, binding=1) uniform image2D output_screen;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.particle_count) return;

    Particle p = particles[idx];
    if (p.enabled < 0.5) return;

    ivec2 pixel      = ivec2(p.position);
    ivec2 pixel_size = ivec2(pc.grid_size) * int(pc.cell_size);
    if (any(lessThan(pixel, ivec2(0))) ||
        any(greaterThanEqual(pixel, pixel_size))) return;

    vec4 out_color = p.color;

    if (int(p.material + 0.5) == 0) {
        // Color liquid by density: blue (expanded) → white (normal) → red (compressed)
        float d = p.liquid_density;
        vec3 col;
        if (d < 1.0) {
            col = mix(vec3(0.2, 0.4, 1.0), vec3(1.0, 1.0, 1.0), clamp(d, 0.0, 1.0));
        } else {
            col = mix(vec3(1.0, 1.0, 1.0), vec3(1.0, 0.1, 0.05), clamp(d - 1.0, 0.0, 1.0));
        }
        out_color = vec4(col, 1.0);
    }

    imageStore(output_screen, pixel, out_color);
}
